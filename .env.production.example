APP_NAME="Smart Water Monitoring"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://water.example.gov.ph
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartwater
DB_USERNAME=smartwater_app
DB_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_WEB_TOKEN_MINUTES=120

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=CHANGE_TO_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_TO_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_TO_SMTP_PASSWORD
MAIL_FROM_ADDRESS="noreply@water.example.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

DEVICE_ACTIVATION_MINUTES=15
DEVICE_TOKEN_DAYS=90
DEVICE_OFFLINE_SECONDS=15
